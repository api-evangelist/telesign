{
  "info": {
    "_postman_id": "5f8cdb29-868b-4de8-b3e7-3ceafb5ac17b",
    "name": "Accounts API",
    "description": "Use this API to programmatically manage your Telesign accounts and their configurations.\n\nContact Support:\n Name: Telesign Customer Support Team\n Email: support@telesign.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:30:11.000Z",
    "updatedAt": "2026-10-22T01:30:11.000Z",
