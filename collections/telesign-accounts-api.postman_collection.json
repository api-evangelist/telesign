  },
  "item": [
    {
      "name": "accounts",
      "item": [
        {
          "name": "{source_account_id}",
          "item": [
            {
              "name": "Clone account",
              "id": "9d876b40-c78a-4550-bd26-11dee14de831",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"account_name\": \"<string>\",\n  \"users\": [\n    {\n      \"first_name\": \"<string>\",\n      \"last_name\": \"<string>\",\n      \"phone\": \"<string>\",\n      \"email\": \"<string>\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/accounts/:source_account_id",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts",
                    ":source_account_id"
                  ],
                  "variable": [
                    {
                      "id": "f8d0f0a5-42b5-4725-acf5-11964d12b193",
                      "key": "source_account_id",
                      "value": "<string>",
                      "description": "(Required) Identifies the source account to clone."
                    }
                  ]
                },
                "description": "> \ud83d\udcd8 NOTE:\n>\n> Accounts API is currently available on a limited basis. Contact our Customer Support Team if you\u2019d like to explore using this API.\n\nUse this endpoint to clone an account. The account corresponding to the account ID in the path of your request is used as the source account. Configuration properties of the source account are applied to the new account.\n\nYou may include contact details for an initial user in the request. Telesign uses those details to send an invitation to sign in to that user, so it's important to ensure that info is valid. You can manually create additional users in your account.\n\nUsers and permissions are not copied from the source account.\n\n## General requirements\n* **Authentication:** Basic (easiest to implement) or Digest\n* **Encoding:** Accepts only **UTF-8 unicode** characters as inputs.\n* **Accepts:** `application/json`\n* **Responds with:** `application/json`\n* **Required headers:** `Content-Type - application/json`"
              },
              "response": [
                {
                  "id": "287e9c9a-4933-4202-9aa3-5e58cb988131",
                  "name": "**Success.** The new account was successfully created.\n\n\nStatus code | Associated text string\n--|--\n5005|New account was successfully created.",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: basic",
                        "key": "Authorization",
                        "value": "Basic <credentials>"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"account_name\": \"<string>\",\n  \"users\": [\n    {\n      \"first_name\": \"<string>\",\n      \"last_name\": \"<string>\",\n      \"phone\": \"<string>\",\n      \"email\": \"<string>\"\n    }\n  ]\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/accounts/:source_account_id",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "accounts",
                        ":source_account_id"
                      ],
                      "variable": [
                        {
                          "key": "source_account_id"
                        }
                      ]
                    }
                  },
                  "status": "Created",
                  "code": 201,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
