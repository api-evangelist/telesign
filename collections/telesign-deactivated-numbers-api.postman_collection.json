  "info": {
    "_postman_id": "f8f5d140-2275-43fb-92f5-cb7bd6eb59a5",
    "name": "Deactivated Numbers API",
    "description": "**Encoding:** Accepts only UTF-8 encoded unicode characters as inputs.\n\nThe Deactivated Numbers API can be used to get lists of deactivated numbers. These can be used to ensure you don't send SMS messages to these numbers using our SMS and SMS Verify products.\n\nContact Support:\n Name: Telesign Customer Support Team\n Email: support@telesign.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:31:09.000Z",
    "updatedAt": "2026-10-22T01:31:10.000Z",
    "lastUpdatedBy": "35240",
